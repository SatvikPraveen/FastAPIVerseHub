# File Location: .env.example
#
# Environment variables template for FastAPIVerseHub
# Copy this file to .env and update with your actual values.
# Variable names MUST match Settings class in app/core/config.py.

# ======================
# ENVIRONMENT SETTINGS
# ======================
ENVIRONMENT=development
DEBUG=true
APP_NAME="FastAPIVerseHub"
APP_VERSION="1.0.0"
HOST=0.0.0.0
PORT=8000

# ======================
# DATABASE CONFIGURATION
# ======================
# Option A — component-based (recommended; URL is built automatically)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fastapi_verse_hub
DATABASE_USER=fastapi_user
DATABASE_PASSWORD=secret

# Option B — full URL (overrides component values when set)
# DATABASE_URL=postgresql+asyncpg://fastapi_user:secret@localhost:5432/fastapi_verse_hub

# ======================
# REDIS CONFIGURATION
# ======================
# Option A — component-based
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Option B — full URL (overrides component values when set)
# REDIS_URL=redis://localhost:6379/0

# ======================
# SECURITY SETTINGS
# ======================
# Generate strong random secrets for production:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================
# EMAIL CONFIGURATION
# ======================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@fastapiversehub.com
EMAIL_USE_TLS=true

# ======================
# FILE UPLOAD SETTINGS
# ======================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,txt,docx,xlsx

# ======================
# EXTERNAL SERVICES / AI
# ======================
OPENAI_API_KEY=your-openai-api-key

# ======================
# OAUTH2 / SOCIAL LOGIN (Optional)
# ======================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ======================
# CORS SETTINGS
# ======================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=*

# ======================
# RATE LIMITING
# ======================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# ======================
# LOGGING CONFIGURATION
# ======================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ======================
# MONITORING & OBSERVABILITY
# ======================
PROMETHEUS_ENABLED=true
SENTRY_DSN=your-sentry-dsn-here

# ======================
# DEVELOPMENT SETTINGS
# ======================
HOT_RELOAD=true

# ======================
# TESTING SETTINGS
# ======================
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
TEST_REDIS_URL=redis://localhost:6379/1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-west-2

# Google Cloud Storage
GCS_BUCKET_NAME=your-gcs-bucket
GCS_CREDENTIALS_PATH=./credentials/gcs-credentials.json

# ======================
# SOCIAL AUTH (Optional)
# ======================
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# ======================
# FEATURE FLAGS
# ======================
ENABLE_REGISTRATION=true
ENABLE_WEBSOCKETS=true
ENABLE_FILE_UPLOADS=true
ENABLE_SOCIAL_AUTH=false