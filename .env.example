# Environment variables template for FastAPIVerseHub.
# Copy to .env and adjust. Names match app/core/config.py exactly; anything
# else is ignored. Secrets are read as SecretStr and never logged.

# ======================
# APPLICATION
# ======================
ENVIRONMENT=development          # development | testing | staging | production
DEBUG=true
APP_NAME="FastAPIVerseHub"
APP_VERSION="1.0.0"
FRONTEND_URL=http://localhost:3000   # base URL used in emailed links
HOST=0.0.0.0
PORT=8000

# ======================
# DATABASE
# ======================
# Option A - components (URL is assembled automatically)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fastapi_verse_hub
DATABASE_USER=fastapi_user
DATABASE_PASSWORD=fastapi_pass
# Option B - full URL (wins over the components; async driver added automatically)
# DATABASE_URL=postgresql://fastapi_user:fastapi_pass@localhost:5432/fastapi_verse_hub
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ======================
# REDIS
# ======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# ======================
# SECURITY
# ======================
# Production refuses to start with a placeholder or short secret.
# Generate one with:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================
# CORS
# ======================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=*

# ======================
# RATE LIMITING (sliding windows, Redis-backed)
# ======================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100             # per 10 seconds

# ======================
# EMAIL
# ======================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@fastapiversehub.com
EMAIL_USE_TLS=true

# ======================
# FILE UPLOADS
# ======================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760           # 10 MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,txt,docx,xlsx

# ======================
# LOGGING & OBSERVABILITY
# ======================
LOG_LEVEL=INFO
LOG_FORMAT=console               # console | json (json is forced in staging/production)
# LOG_FILE=./logs/app.log        # optional rotating file in addition to stdout
SLOW_REQUEST_THRESHOLD_SECONDS=1.0
PROMETHEUS_ENABLED=true          # exposes /metrics
HEALTH_CHECK_TIMEOUT=5           # seconds per dependency in /health/ready

# ======================
# OAUTH2 / SOCIAL LOGIN (optional)
# ======================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
